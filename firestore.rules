rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isValidId(teacherId) &&
        incoming().id is string &&
        incoming().fullName is string &&
        incoming().fullName.size() > 0;
    }

    // Form 01 submissions
    match /form01/{docKey} {
      allow read: if true;
      allow write: if isValidId(docKey) &&
        incoming().teacherId is string &&
        incoming().teacherId.size() > 0;
    }

    // Evaluations (Form 03 / Form 02)
    match /evaluations/{evalKey} {
      allow read: if true;
      allow write: if isValidId(evalKey) &&
        incoming().teacherId is string &&
        incoming().teacherId.size() > 0;

      // Subcollection criteriaScores (Section II & III)
      match /criteriaScores/{criterionId} {
        allow read: if true;
        allow write: if isValidId(criterionId);
      }
    }

    // Entry status (Báo đã nhập)
    match /entry_status/{statusId} {
      allow read: if true;
      allow write: if isValidId(statusId);
    }

    // Evaluation history / Audit log (Section VI)
    match /evaluation_history/{historyId} {
      allow read: if true;
      allow write: if isValidId(historyId);
    }

    // System backups (Section VII)
    match /system_backups/{backupId} {
      allow read: if true;
      allow write: if isValidId(backupId);
    }

    // System settings (Khóa kỳ đánh giá, thiết lập năm học)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
